generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  JOB_SEEKER
  COMPANY
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  SHORTLISTED
  REJECTED
  ACCEPTED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(JOB_SEEKER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobsCreated  Job[]         @relation("CompanyJobs")
  applications Application[] @relation("SeekerApplications")

  @@map("users")
}

model Job {
  id          String   @id @default(uuid())
  title       String
  description String
  companyName String
  location    String
  salary      String
  jobType     String   // Full-time, Part-time, Remote, Hybrid, Contract
  companyId   String
  company     User     @relation("CompanyJobs", fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]

  @@map("jobs")
}

model Application {
  id        String            @id @default(uuid())
  jobId     String
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seekerId  String
  seeker    User              @relation("SeekerApplications", fields: [seekerId], references: [id], onDelete: Cascade)
  status    ApplicationStatus @default(APPLIED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  histories ApplicationHistory[]

  @@unique([jobId, seekerId], name: "unique_job_seeker_application")
  @@map("applications")
}

model ApplicationHistory {
  id            String             @id @default(uuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String
  notes         String?
  createdAt     DateTime           @default(now())

  @@map("application_histories")
}
